+
+    def _unpack_rowwise_components(packed_tensor: torch.Tensor):
+        """Split packed FP4 values/scales that were concatenated along the last dimension."""
+        if packed_tensor.dim() < 1:
+            raise ValueError("Packed FP4 tensor must have at least one dimension.")
+
+        last_dim = packed_tensor.size(-1)
+        numerator = last_dim * FP4_VALUES_PER_SCALE
+        divisor = FP4_VALUES_PER_SCALE + 1
+
+        if numerator % divisor != 0:
+            raise ValueError(
+                f"Cannot infer FP4 rowwise/scale split for last_dim={last_dim}. "
+                "Dimension must be divisible by the 17/16 packing ratio."
+            )
+
+        rowwise_width = numerator // divisor
+        scale_width = last_dim - rowwise_width
+
+        if scale_width <= 0:
+            raise ValueError("Packed FP4 tensor does not contain scale elements.")
+
+        rowwise_data = packed_tensor.narrow(-1, 0, rowwise_width).contiguous()
+        rowwise_scale = packed_tensor.narrow(-1, rowwise_width, scale_width).contiguous()
